# ==============================================================================
# Mubdev Portfolio Backend - Environment Configuration Template
# Copy this file to .env and configure your local/production settings
# ==============================================================================

# Application Environment
DEBUG=true
SECRET_KEY=mubdev-secret-key-change-this-in-production-use-strong-random-string

# Database Configuration (MySQL / MariaDB via PDO)
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mubdev_db
DB_USER=root
DB_PASSWORD=

# Security & CORS
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate Limiting
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW=3600
