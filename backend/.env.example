# ==============================================================================
# MUBDEV BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# Django Secret Key (Generate a random unique key for production)
SECRET_KEY=django-insecure-mubdev-brand-portfolio-development-secret-key-2026

# Debug Mode (True for local development, False for production)
DEBUG=True

# Allowed Hosts (Comma-separated hostnames/IPs)
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
# Options for DB_ENGINE:
# - django.db.backends.mysql  (Official target production/staging database)
# - django.db.backends.sqlite3 (Local development fallback)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=mubdev_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# CORS Configuration
# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

